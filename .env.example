# MangaDex WebDL — copy to .env and edit. Read by Docker Compose and by the app containers.

# ------------------------------------------------------------------ image
# Published image (GitHub Container Registry or Docker Hub), e.g.
#   ghcr.io/lainx84/mangadex-webdl:latest
#   lainx84/mangadex-webdl:latest   (Docker Hub)
MDM_IMAGE=ghcr.io/lainx84/mangadex-webdl:latest

# ------------------------------------------------------------------ host paths
# Dedicated folder (normally on a host NFS mount of your NAS) holding ONLY the library and its
# two working folders; bind-mounted at /mangadex. It must exist before `docker compose up`.
MDM_LIBRARY_PATH=/mnt/nas/manga/MangaDex-WebDL
# Optional existing CBZ collection, mounted read-only at /archive. Leave the default (an empty
# ./archive folder) to keep the feature off.
MDM_ARCHIVE_PATH=./archive
# PostgreSQL, Redis and cover cache. Keep it on local disk, NOT on the NAS.
MDM_APPDATA_PATH=./appdata
# Docker secrets (db_password, md_client_id, md_client_secret, md_username, md_password)
MDM_SECRETS_PATH=./secrets

# User the app runs as: must be able to write to MDM_LIBRARY_PATH (check the NAS squash mapping)
PUID=1000
PGID=1000
TZ=UTC

# ------------------------------------------------------------------ web
# Published port. Bind to a LAN IP (e.g. 192.0.2.10) instead of 0.0.0.0 if you can.
MDM_BIND_ADDRESS=0.0.0.0
MDM_PORT=8098
# External HTTPS URL when the app is behind a reverse proxy (e.g. Nginx Proxy Manager)
MDM_PUBLIC_URL=
# IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted (nobody else's are),
# e.g. 172.16.0.0/12 for a proxy on a Docker network of the same host
MDM_TRUSTED_PROXIES=
# auto = Secure cookies whenever the request came over HTTPS through a trusted proxy
MDM_COOKIE_SECURE=auto

# ------------------------------------------------------------------ paths inside the container
MDM_DOWNLOADS_ROOT=/mangadex/MangaDex
# Downloads in progress (moved into the library only when complete)
MDM_STAGING_ROOT=/mangadex/Incoming
# Previous copies of redownloaded / re-uploaded / revised chapters
MDM_REPLACED_ROOT=/mangadex/Replaced
# Folder holding the .mdm-library sentinel: the folder above the library, so moving the whole
# content of the library by hand never takes it away. Empty = the library root.
MDM_SENTINEL_DIR=/mangadex
# Accepted filesystem types for the library (protects against writing into an unmounted
# mountpoint). Empty disables the check, e.g. for a local disk.
MDM_EXPECTED_FS_TYPES=nfs,nfs4

# ------------------------------------------------------------------ database / queue
MDM_DB_HOST=db
MDM_DB_NAME=mangadex_webdl
MDM_DB_USER=mangadex_webdl
MDM_DB_PASSWORD_FILE=/run/secrets/db_password
MDM_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ misc
MDM_LOG_LEVEL=INFO
MDM_DOWNLOAD_WORKERS=4
# Optional: create the administrator at startup instead of using the one-time setup token
# MDM_ADMIN_USERNAME=admin
# MDM_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
